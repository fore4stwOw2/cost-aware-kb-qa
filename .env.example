# 把本文件复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会被提交）
# 任何"OpenAI 兼容"服务商都行：DeepSeek / Kimi / 智谱 / SiliconFlow …
# 建议新手用 DeepSeek：注册即送额度、国内直连、价格便宜。

# 你的 API key（服务商控制台里生成）
OPENAI_API_KEY=

# 服务商的接口地址，例如 DeepSeek 填 https://api.deepseek.com
OPENAI_BASE_URL=

# 聊天模型名，例如 DeepSeek 填 deepseek-chat（以服务商文档为准）
CHAT_MODEL=
